{
  "name": "lxon-founder-device",
  "version": "1.0.0",
  "description": "LXON Founder Raspberry Pi Device - Activate, freeze, and deactivate physical coins",
  "license": "MIT",
  "bin": {
    "lxon-founder": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "api": "tsx src/api/server.ts",
    "ui": "tsx src/ui/server.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "start:api": "node dist/api/server.js",
    "install:pi": "bash scripts/install-pi.sh",
    "setup:nfc": "bash scripts/setup-nfc.sh"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "open": "^8.4.2",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.14",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
