generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  emailVerified           Boolean   @default(false)
  emailVerifiedAt         DateTime?
  name                    String?
  image                   String?
  password                String?
  role                    String    @default("USER")
  isActive                Boolean   @default(true)
  isTwoFactorEnabled      Boolean   @default(false)
  twoFactorSecret         String?
  encryptedData           String?
  dataIv                  String?
  dataAuthTag             String?
  pinHash                 String?
  biometricEnabled        Boolean   @default(false)
  biometricPublicKey      String?
  isPinBiometricRequired  Boolean   @default(false)
  lastLoginAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  wallets          Wallet[]
  transactions     Transaction[]
  alerts           Alert[]
  notifications    Notification[]
  subscriptions    Subscription[]
  apiKeys          ApiKey[]
  watchlists       Watchlist[]
  settings         Settings?
  governanceVotes  GovernanceVote[]
  stakingPositions StakingPosition[]
  chats            Chat[]
  messages         Message[]
  referralCodes    ReferralCode[]
  referralRewards  ReferralReward[]
  invoices         Invoice[]
  payments         Payment[]
  auditLogs        AuditLog[]
  systemLogs       SystemLog[]
  deployments      Deployment[]
  orders           Order[]

  @@index([email])
  @@index([createdAt])
  @@index([role])
  @@map("users")
}

model Wallet {
  id                     String    @id @default(uuid())
  userId                 String
  address                String
  chain                  String
  label                  String?
  type                   String    @default("EOA")
  isActive               Boolean   @default(true)
  isWatchOnly            Boolean   @default(false)
  ensName                String?
  recoveryMethod         String?
  recoveryEncryptedShard String?
  socialRecoveryContacts String?
  lastSyncAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances         TokenBalance[]
  nfts             Nft[]
  transactions     Transaction[]
  alerts           Alert[]
  stakingPositions StakingPosition[]
  orders           Order[]

  @@unique([userId, address, chain])
  @@index([userId])
  @@index([address])
  @@index([chain])
  @@index([isActive])
  @@map("wallets")
}

model TokenBalance {
  id           String   @id @default(uuid())
  walletId     String
  tokenAddress String
  symbol       String
  name         String
  decimals     Int
  balance      String
  balanceUsd   Float?
  priceUsd     Float?
  change24h    Float?
  lastUpdated  DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, tokenAddress])
  @@index([walletId])
  @@index([symbol])
  @@index([balanceUsd])
  @@map("token_balances")
}

model Nft {
  id               String   @id @default(uuid())
  walletId         String
  contractAddress  String
  tokenId          String
  name             String?
  description      String?
  imageUrl         String?
  collectionName   String?
  floorPriceUsd    Float?
  lastSalePriceUsd Float?
  rarityRank       Int?
  traits           String?
  lastUpdated      DateTime @default(now())
  createdAt        DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, contractAddress, tokenId])
  @@index([walletId])
  @@index([collectionName])
  @@map("nfts")
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  walletId        String?
  hash            String
  chain           String
  type            String
  fromAddress     String
  toAddress       String?
  value           String
  valueUsd        Float?
  gasUsed         String?
  gasPrice        String?
  feeUsd          Float?
  blockNumber     Int?
  status          String
  timestamp       DateTime
  decodedFunction String?
  contractAddress String?
  tokenSymbol     String?
  metadata        String?
  createdAt       DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([walletId])
  @@index([hash])
  @@index([chain])
  @@index([status])
  @@index([timestamp])
  @@index([type])
  @@map("transactions")
}

model Chat {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  isActive  Boolean  @default(true)
  context   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([createdAt])
  @@map("chats")
}

model Message {
  id         String   @id @default(uuid())
  chatId     String
  userId     String
  role       String
  content    String
  tokensUsed Int?
  model      String?
  metadata   String?
  createdAt  DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([userId])
  @@index([createdAt])
  @@map("messages")
}

model Alert {
  id              String    @id @default(uuid())
  userId          String
  walletId        String?
  type            String
  condition       String
  status          String    @default("ACTIVE")
  lastTriggeredAt DateTime?
  triggerCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet?       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  notification Notification?

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@map("alerts")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  alertId   String?   @unique
  type      String
  title     String
  message   String
  data      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert Alert? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Subscription {
  id                String   @id @default(uuid())
  userId            String
  plan              String
  status            String
  startDate         DateTime
  endDate           DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  aiQueryLimit      Int
  aiQueriesUsed     Int      @default(0)
  features          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

model Invoice {
  id                 String    @id @default(uuid())
  subscriptionId     String
  userId             String
  amount             Float
  currency           String    @default("USD")
  status             String
  paymentMethod      String?
  transactionId      String?
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  paidAt             DateTime?
  createdAt          DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  @@map("invoices")
}

model Payment {
  id                String    @id @default(uuid())
  userId            String
  invoiceId         String?
  provider          String
  providerPaymentId String
  amount            Float
  currency          String    @default("USD")
  status            String
  metadata          String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

model ReferralCode {
  id        String    @id @default(uuid())
  userId    String
  code      String    @unique
  uses      Int       @default(0)
  maxUses   Int       @default(100)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralRewards ReferralReward[]

  @@index([code])
  @@index([userId])
  @@map("referral_codes")
}

model ReferralReward {
  id             String    @id @default(uuid())
  referrerId     String
  refereeId      String?
  referralCodeId String
  rewardType     String
  amount         Float
  currency       String    @default("CMAI")
  status         String    @default("PENDING")
  claimedAt      DateTime?
  createdAt      DateTime  @default(now())

  referrer     User         @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referralCodeId])
  @@index([status])
  @@map("referral_rewards")
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  permissions String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@index([isActive])
  @@map("api_keys")
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  name      String
  symbols   String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("watchlists")
}

model Settings {
  id                String   @id @default(uuid())
  userId            String   @unique
  theme             String   @default("dark")
  currency          String   @default("USD")
  timezone          String   @default("UTC")
  notificationEmail Boolean  @default(true)
  notificationPush  Boolean  @default(true)
  notificationInApp Boolean  @default(true)
  alertEmail        Boolean  @default(true)
  alertPush         Boolean  @default(true)
  alertInApp        Boolean  @default(true)
  metadata          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model GovernanceVote {
  id              String   @id @default(uuid())
  userId          String
  proposalId      String
  choice          String
  votingPower     Float
  transactionHash String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, proposalId])
  @@index([proposalId])
  @@map("governance_votes")
}

model StakingPosition {
  id                 String    @id @default(uuid())
  userId             String
  walletId           String
  amount             Float
  apy                Float
  startDate          DateTime
  endDate            DateTime
  status             String
  rewardClaimed      Float     @default(0)
  rewardClaimedAt    DateTime?
  unstakeRequestedAt DateTime?
  transactionHash    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([endDate])
  @@map("staking_positions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?
  level     String
  message   String
  context   String?
  error     String?
  stack     String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([userId])
  @@index([createdAt])
  @@map("system_logs")
}

model Token {
  id           String   @id @default(uuid())
  address      String   @unique
  chain        String
  symbol       String
  name         String
  decimals     Int
  logoUrl      String?
  description  String?
  website      String?
  twitter      String?
  telegram     String?
  discord      String?
  github       String?
  totalSupply  String?
  marketCapUsd Float?
  volumeUsd24h Float?
  priceUsd     Float?
  change24h    Float?
  liquidityUsd Float?
  riskScore    Int?     @default(0)
  riskFactors  String?
  isVerified   Boolean  @default(false)
  isScam       Boolean  @default(false)
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([symbol])
  @@index([chain])
  @@index([marketCapUsd])
  @@index([riskScore])
  @@index([isScam])
  @@map("tokens")
}

model Deployment {
  id              String    @id @default(uuid())
  userId          String
  name            String
  chain           String
  contractAddress String?
  status          String    @default("PENDING")
  transactionHash String?
  gasUsed         String?
  gasCostUsd      Float?
  blockNumber     Int?
  deployedAt      DateTime?
  metadata        String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chain])
  @@map("deployments")
}

model Order {
  id              String    @id @default(uuid())
  userId          String
  walletId        String?
  chain           String
  side            String
  type            String
  price           Float
  amount          Float
  filledAmount    Float     @default(0)
  remainingAmount Float
  status          String    @default("PENDING")
  commitHash      String?
  revealed        Boolean   @default(false)
  mevProtected    Boolean   @default(true)
  batchId         String?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  buyMatches  OrderMatch[] @relation("BuyOrderMatches")
  sellMatches OrderMatch[] @relation("SellOrderMatches")

  @@index([userId])
  @@index([walletId])
  @@index([chain])
  @@index([status])
  @@index([side])
  @@index([createdAt])
  @@index([batchId])
  @@map("orders")
}

model OrderMatch {
  id              String    @id @default(uuid())
  buyOrderId      String
  sellOrderId     String
  chain           String
  price           Float
  amount          Float
  fee             Float     @default(0)
  status          String    @default("PENDING")
  executedAt      DateTime?
  batchId         String
  metadata        String?
  createdAt       DateTime  @default(now())

  buyOrder  Order @relation("BuyOrderMatches", fields: [buyOrderId], references: [id], onDelete: Cascade)
  sellOrder Order @relation("SellOrderMatches", fields: [sellOrderId], references: [id], onDelete: Cascade)

  @@index([buyOrderId])
  @@index([sellOrderId])
  @@index([chain])
  @@index([batchId])
  @@index([createdAt])
  @@map("order_matches")
}
