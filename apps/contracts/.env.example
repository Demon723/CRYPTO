# ⚠️  IMPORTANT SECURITY WARNING ⚠️
# - Never commit your actual private key to version control
# - Use a hardware wallet or multi-sig for mainnet deployment
# - Ensure you have sufficient ETH for gas fees
# - Test thoroughly on testnet before mainnet deployment

# Private key for deployment (generate with: npx hardhat account generate)
# For mainnet, consider using a hardware wallet or multi-sig
PRIVATE_KEY=your_private_key_here

# Ethereum Mainnet RPC URL
# Recommended: Infura, Alchemy, or your own node
MAINNET_RPC_URL=https://mainnet.infura.io/v3/your_project_id

# Sepolia Testnet RPC URL (for testnet deployment)
SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co

# Infura API Key (for RPC connections)
INFURA_API_KEY=your_infura_api_key

# Etherscan API Key (for contract verification on mainnet)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Multi-sig Treasury Address (for mainnet buyback operations)
# This should be a secure multi-sig wallet like Gnosis Safe
TREASURY_ADDRESS=your_multisig_address_here

