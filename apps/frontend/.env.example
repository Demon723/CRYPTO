NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Blockchain RPCs
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org/
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-api-key
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-api-key
NEXT_PUBLIC_AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Etherscan APIs
NEXT_PUBLIC_ETHERSCAN_API_KEY=your-etherscan-api-key
NEXT_PUBLIC_BSCSCAN_API_KEY=your-bscscan-api-key
NEXT_PUBLIC_POLYGONSCAN_API_KEY=your-polygonscan-api-key
NEXT_PUBLIC_ARBISCAN_API_KEY=your-arbiscan-api-key
NEXT_PUBLIC_BASESCAN_API_KEY=your-basescan-api-key
NEXT_PUBLIC_SNOWTRACE_API_KEY=your-snowtrace-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Platform Token
NEXT_PUBLIC_PLATFORM_TOKEN_ADDRESS=
NEXT_PUBLIC_PLATFORM_TOKEN_SYMBOL=CMAI

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# App Configuration
NEXT_PUBLIC_APP_NAME=CryptoMind AI
NEXT_PUBLIC_APP_URL=https://cryptomind.ai
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_MAX_FREE_QUERIES=10
NEXT_PUBLIC_DEFAULT_CHAIN=ethereum
