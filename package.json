{
  "name": "lxon",
  "version": "1.0.0",
  "description": "LXON Cryptocurrency Program",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "lxon": "./cli.ts"
  },
  "scripts": {
    "cli": "tsx cli.ts",
    "demo": "tsx apps/lxon-blockchain/src/demo.ts",
    "build": "pnpm run -r build",
    "build:blockchain": "pnpm --filter lxon-blockchain build",
    "build:contracts": "pnpm --filter lxon-contracts compile",
    "test": "pnpm run -r test",
    "test:blockchain": "pnpm --filter lxon-blockchain test",
    "test:contracts": "pnpm --filter lxon-contracts test",
    "typecheck": "pnpm run -r typecheck",
    "clean": "pnpm run -r clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "cryptocurrency",
    "blockchain",
    "smart-contracts",
    "crypto"
  ],
  "author": "LXON Team",
  "license": "MIT"
}
