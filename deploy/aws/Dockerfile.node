FROM node:22-alpine AS builder

WORKDIR /app

COPY apps/lxon-blockchain/package.json ./apps/lxon-blockchain/
COPY pnpm-lock.yaml pnpm-workspace.yaml ./

RUN corepack enable && pnpm install --filter lxon-blockchain --frozen-lockfile

COPY apps/lxon-blockchain ./apps/lxon-blockchain

RUN pnpm --filter lxon-blockchain build

FROM node:22-alpine

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/lxon-blockchain ./apps/lxon-blockchain
COPY --from=builder /app/pnpm-lock.yaml ./

EXPOSE 8545 8546

CMD ["npx", "tsx", "apps/lxon-blockchain/src/rpc/node.ts"]
